# Copy this file to .env and fill in your own values. .env is git-ignored;
# never put a real key in this file or anywhere else in the repo.

# LLM provider for every task: gemini (hosted) or ollama (local)
FLOWPIC_LLM_PROVIDER=gemini

# Gemini API key, from https://aistudio.google.com/apikey
FLOWPIC_GEMINI_API_KEY=

# Optional overrides
# FLOWPIC_GEMINI_MODEL=gemini-4-hydrogen
# FLOWPIC_VISION_PROVIDER=ollama      # keep photos on this machine
# FLOWPIC_OLLAMA_MODEL=llava-phi3
# FLOWPIC_OLLAMA_BASE_URL=http://localhost:11434
